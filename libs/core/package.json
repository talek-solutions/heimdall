{
  "name": "@heimdall/core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./src/enums/index.ts",
      "default": "./dist/enums/index.js"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./dist/errors/index.js"
    },
    "./manifest": {
      "types": "./src/manifest/index.ts",
      "default": "./dist/manifest/index.js"
    },
    "./graph": {
      "types": "./src/graph/index.ts",
      "default": "./dist/graph/index.js"
    }
  },
  "scripts": {
    "build": "swc src -d dist --config-file ../../.swcrc --strip-leading-paths"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "yaml": "^2.9.1"
  }
}
